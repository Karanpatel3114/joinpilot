      "metric_id": "aging_top_customers",
      "title": "Top 10 customers by open amount",
      "description": "Open DMBTR per KNA1 customer and aging bucket; items without a matching customer are left out.",
      "view": "v_bsid",
      "sql": "SELECT \"KNA1__KUNNR\" AS customer_id, MAX(\"KNA1__NAME1\") AS customer_name, ROUND(SUM(\"DMBTR\"), 2) AS total, ROUND(SUM(CASE WHEN \"aging_bucket\" = 'not_due' THEN \"DMBTR\" ELSE 0 END), 2) AS \"bucket_not_due\", ROUND(SUM(CASE WHEN \"aging_bucket\" = '1-30' THEN \"DMBTR\" ELSE 0 END), 2) AS \"bucket_1-30\", ROUND(SUM(CASE WHEN \"aging_bucket\" = '31-60' THEN \"DMBTR\" ELSE 0 END), 2) AS \"bucket_31-60\", ROUND(SUM(CASE WHEN \"aging_bucket\" = '61-90' THEN \"DMBTR\" ELSE 0 END), 2) AS \"bucket_61-90\", ROUND(SUM(CASE WHEN \"aging_bucket\" = '90+' THEN \"DMBTR\" ELSE 0 END), 2) AS \"bucket_90+\" FROM model.\"v_bsid\" WHERE \"KNA1__KUNNR\" IS NOT NULL GROUP BY 1 ORDER BY total DESC, customer_id LIMIT 10",
