      "metric_id": "aging_buckets",
      "title": "Open receivables by aging bucket",
      "description": "Sum of DMBTR per aging bucket, as of the reference date.",
      "view": "v_bsid",
      "sql": "SELECT \"aging_bucket\" AS bucket, ROUND(SUM(\"DMBTR\"), 2) AS amount FROM model.\"v_bsid\" GROUP BY \"aging_bucket\" ORDER BY CASE \"aging_bucket\" WHEN 'not_due' THEN 0 WHEN '1-30' THEN 1 WHEN '31-60' THEN 2 WHEN '61-90' THEN 3 WHEN '90+' THEN 4 ELSE 5 END",
      "chart": "bar",
      "x": "bucket",
