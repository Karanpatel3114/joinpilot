# JoinPilot environment variables. Copy to .env and fill in real values.
# .env is gitignored; never commit secrets. Every setting has a safe default,
# so all lines below are optional. Nested settings use a double underscore.

# --- App ---
# dev | test | prod
APP_ENV=dev
# Python logging level
LOG_LEVEL=INFO
# Where project folders, DuckDB files and generated data live
DATA_DIR=./data
# Browser origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# --- Limits ---
# Maximum size of one uploaded CSV or Parquet file, in megabytes
MAX_UPLOAD_MB=50
# Maximum number of tables in one project
MAX_TABLES_PER_PROJECT=30
# Uploads wider than this are refused before loading
MAX_COLUMNS_PER_TABLE=200
# Memory and threads each project's DuckDB may use
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
# Sample dataset sizes users may load (JSON list of S, M, L)
SAMPLE_SIZES=["S","M"]

# --- Profiling (PROFILING__<NAME>) ---
# Example values shown per column
PROFILING__SAMPLE_VALUES=5
# Columns considered when searching two-column keys
PROFILING__MAX_PAIR_COLUMNS=12
# Distinct source values checked per overlap (larger columns are sampled)
PROFILING__OVERLAP_SAMPLE_SIZE=10000
# Longer text values are never compared as keys
PROFILING__OVERLAP_MAX_VALUE_LENGTH=40
# Overlaps below this inclusion ratio are not recorded
PROFILING__OVERLAP_MIN_RATIO=0.1
# At most this many columns are compared, and this many overlaps kept
PROFILING__OVERLAP_MAX_COLUMNS=300
PROFILING__OVERLAP_MAX_RESULTS=5000
# Columns aggregated per statistics query
PROFILING__STATS_BATCH_COLUMNS=50
# A normalization must raise the inclusion ratio by at least this much
PROFILING__NORMALIZATION_MIN_GAIN=0.1

# --- Synthetic data generator (SYNTH__<NAME>, SYNTH__ISSUES__<NAME>) ---
# Changing these changes the data; split gold always uses the defaults.
# SYNTH__EUR_SHARE=0.10
# SYNTH__ISSUES__ORPHAN_ORDER_ITEMS=0.01
# SYNTH__ISSUES__ORPHAN_OPEN_ITEMS=0.005
# SYNTH__ISSUES__DUPLICATE_CUSTOMERS=0.005
# SYNTH__ISSUES__NULL_KEY_OPEN_ITEMS=0.003
# SYNTH__ISSUES__STRIPPED_ZEROS_OPEN_ITEMS=1.0

# --- Join candidates (JOINS__<NAME>) ---
# Overlap needed before a column pair becomes a join candidate
JOINS__CANDIDATE_MIN_INCLUSION=0.5
# A target column counts as unique (N:1 join) at or above this uniqueness
JOINS__UNIQUE_MIN=0.999
# Score = weighted inclusion, name similarity, coverage and key strength
JOINS__WEIGHT_INCLUSION=0.35
JOINS__WEIGHT_NAME=0.35
JOINS__WEIGHT_COVERAGE=0.15
JOINS__WEIGHT_KEY_STRENGTH=0.15
# Target distinct count at which key strength reaches 1.0 (must be above 1)
JOINS__KEY_STRENGTH_FULL_AT=50
# Credit for names that only look alike (equal stems always score 1.0)
JOINS__NAME_FUZZY_WEIGHT=0.5
# A prefix such as o_ is stripped when this share of a table's columns use it
JOINS__PREFIX_MIN_SHARE=0.8
JOINS__PREFIX_MAX_LENGTH=4
# Both overlap directions must reach this for a 1:1 join between two unique keys
JOINS__ONE_TO_ONE_MIN_OVERLAP=0.95
# Score multiplier for pairs whose target is not unique (N:M)
JOINS__N_TO_M_FACTOR=0.5
# Minimum score for a join to be proposed
JOINS__ACCEPT_THRESHOLD=0.7
# A small non-numeric column in a two-column key with every value present per
# key (for example a language) marks an attribute table that fans out; it may
# have at most this many values (and no more than PROFILING__SAMPLE_VALUES)
JOINS__DISCRIMINATOR_MAX_DISTINCT=5
JOINS__DISCRIMINATOR_FILL=0.9
# Filter values preferred for such tables (JSON list)
JOINS__PREFERRED_FILTER_VALUES=["E","EN","en"]

# --- Language model (LLM__<NAME>) ---
# Free key from https://aistudio.google.com/apikey. Do not enable billing on the
# Google Cloud project: without billing the free tier can never charge you.
GEMINI_API_KEY=
# gemini (default) or fake (offline, for tests and demos without a key)
LLM__PROVIDER=gemini
# A free-tier model; the -latest alias tracks Google's current Flash-Lite
LLM__MODEL=gemini-flash-lite-latest
LLM__TEMPERATURE=0.0
LLM__TIMEOUT_SECONDS=30
# Retries for rate limits and server errors, with exponential backoff
LLM__MAX_RETRIES=3
LLM__BACKOFF_BASE_SECONDS=2
LLM__BACKOFF_MAX_SECONDS=30
# Cache validated answers on disk to save free-tier quota
LLM__CACHE_RESPONSES=true
# Paid list prices for cost estimates, USD per million tokens (JSON); empty = $0
LLM__PRICES_PER_MILLION={}
