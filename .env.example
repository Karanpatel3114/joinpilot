# JoinPilot environment variables. Copy to .env and fill in real values.
# .env is gitignored; never commit secrets.

# --- App ---
# dev | test | prod
APP_ENV=dev
# Python logging level
LOG_LEVEL=INFO
# Where project folders, DuckDB files and generated data live
DATA_DIR=./data
# Browser origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# --- Limits ---
# Maximum size of one uploaded CSV or Parquet file, in megabytes
MAX_UPLOAD_MB=50
