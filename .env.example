# JoinPilot environment variables. Copy to .env and fill in real values.
# .env is gitignored; never commit secrets. Every setting has a safe default,
# so all lines below are optional. Nested settings use a double underscore.

# --- App ---
# dev | test | prod
APP_ENV=dev
# Python logging level
LOG_LEVEL=INFO
# Where project folders, DuckDB files and generated data live
DATA_DIR=./data
# App database. Docker Compose: postgresql+psycopg://joinpilot:joinpilot@localhost:5432/joinpilot
# Empty means a SQLite file in DATA_DIR (fine for local use without Docker)
DATABASE_URL=
# Redis for background jobs. Docker Compose: redis://localhost:6379/0
# Empty means jobs run in a background thread inside the API process
REDIS_URL=
# inline (runs inside the request; tests), thread (local default) or arq (needs REDIS_URL)
JOBS_MODE=thread
# Runs processed at once, and the time limit for one job
JOBS_MAX_CONCURRENT=2
JOBS_TIMEOUT_SECONDS=600
# How long Redis remembers a finished job (also blocks duplicate job ids meanwhile)
JOBS_KEEP_RESULT_SECONDS=3600
# Postgres connection pool per process
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Browser origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
# Build a read-only sample project at startup that every visitor can open (public demo)
DEMO_MODE=false

# --- Limits ---
# Maximum size of one uploaded CSV or Parquet file, in megabytes
MAX_UPLOAD_MB=50
# Maximum number of tables in one project
MAX_TABLES_PER_PROJECT=30
# Uploads wider than this are refused before loading
MAX_COLUMNS_PER_TABLE=200
# Memory and threads each project's DuckDB may use
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
# Sample dataset sizes users may load (JSON list of S, M, L)
SAMPLE_SIZES=["S","M"]

# --- Profiling (PROFILING__<NAME>) ---
# Example values shown per column
PROFILING__SAMPLE_VALUES=5
# Columns considered when searching two-column keys
PROFILING__MAX_PAIR_COLUMNS=12
# Distinct source values checked per overlap (larger columns are sampled)
PROFILING__OVERLAP_SAMPLE_SIZE=10000
# Longer text values are never compared as keys
PROFILING__OVERLAP_MAX_VALUE_LENGTH=40
# Overlaps below this inclusion ratio are not recorded
PROFILING__OVERLAP_MIN_RATIO=0.1
# At most this many columns are compared, and this many overlaps kept
PROFILING__OVERLAP_MAX_COLUMNS=300
PROFILING__OVERLAP_MAX_RESULTS=5000
# Columns aggregated per statistics query
PROFILING__STATS_BATCH_COLUMNS=50
# A normalization must raise the inclusion ratio by at least this much
PROFILING__NORMALIZATION_MIN_GAIN=0.1

# --- Synthetic data generator (SYNTH__<NAME>, SYNTH__ISSUES__<NAME>) ---
# Changing these changes the data; split gold always uses the defaults.
# SYNTH__EUR_SHARE=0.10
# SYNTH__ISSUES__ORPHAN_ORDER_ITEMS=0.01
# SYNTH__ISSUES__ORPHAN_OPEN_ITEMS=0.005
# SYNTH__ISSUES__DUPLICATE_CUSTOMERS=0.005
# SYNTH__ISSUES__NULL_KEY_OPEN_ITEMS=0.003
# SYNTH__ISSUES__STRIPPED_ZEROS_OPEN_ITEMS=1.0

# --- Join candidates (JOINS__<NAME>) ---
# Overlap needed before a column pair becomes a join candidate
JOINS__CANDIDATE_MIN_INCLUSION=0.5
# A target column counts as unique (N:1 join) at or above this uniqueness
JOINS__UNIQUE_MIN=0.999
# Score = weighted inclusion, name similarity, coverage and key strength
JOINS__WEIGHT_INCLUSION=0.35
JOINS__WEIGHT_NAME=0.35
JOINS__WEIGHT_COVERAGE=0.15
JOINS__WEIGHT_KEY_STRENGTH=0.15
# Target distinct count at which key strength reaches 1.0 (must be above 1)
JOINS__KEY_STRENGTH_FULL_AT=50
# Credit for names that only look alike (equal stems always score 1.0)
JOINS__NAME_FUZZY_WEIGHT=0.5
# A prefix such as o_ is stripped when this share of a table's columns use it
JOINS__PREFIX_MIN_SHARE=0.8
JOINS__PREFIX_MAX_LENGTH=4
# Both overlap directions must reach this for a 1:1 join between two unique keys
JOINS__ONE_TO_ONE_MIN_OVERLAP=0.95
# Score multiplier for pairs whose target is not unique (N:M)
JOINS__N_TO_M_FACTOR=0.5
# Minimum score for a join to be proposed
JOINS__ACCEPT_THRESHOLD=0.7
# A small non-numeric column in a two-column key with every value present per
# key (for example a language) marks an attribute table that fans out; it may
# have at most this many values (and no more than PROFILING__SAMPLE_VALUES)
JOINS__DISCRIMINATOR_MAX_DISTINCT=5
JOINS__DISCRIMINATOR_FILL=0.9
# Filter values preferred for such tables (JSON list)
JOINS__PREFERRED_FILTER_VALUES=["E","EN","en"]

# --- Language model (LLM__<NAME>) ---
# Free key from https://aistudio.google.com/apikey. Do not enable billing on the
# Google Cloud project: without billing the free tier can never charge you.
GEMINI_API_KEY=
# gemini (default) or fake (offline, for tests and demos without a key)
LLM__PROVIDER=gemini
# A free-tier model, pinned to a release (the old -latest alias was retired)
LLM__MODEL=gemini-3.5-flash-lite
# 0 makes answers as repeatable as the model allows
LLM__TEMPERATURE=0.0
# Seconds before a model call is abandoned (and retried as a timeout)
LLM__TIMEOUT_SECONDS=30
# Retries for rate limits and server errors, with exponential backoff
LLM__MAX_RETRIES=3
LLM__BACKOFF_BASE_SECONDS=2
LLM__BACKOFF_MAX_SECONDS=30
# Cache validated answers on disk to save free-tier quota
LLM__CACHE_RESPONSES=true
# Paid list prices for cost estimates, USD per million tokens (JSON); empty = $0
LLM__PRICES_PER_MILLION={}

# --- Agent (AGENT__<NAME>) ---
# Example values per column shown to the model when parsing a requirement
AGENT__PROMPT_EXAMPLE_VALUES=2
# At most this many candidates are sent to the model for ranking
AGENT__RANKING_MAX_CANDIDATES=25
# The model may recommend a candidate the scorer rejected only at or above this score
AGENT__RESCUE_MIN_SCORE=0.5
# Percentages in explanations must be within this many points of the evidence
AGENT__EXPLANATION_TOLERANCE_POINTS=0.6
# Attempts to repair views whose checks show duplicated or lost rows
AGENT__MAX_REPAIRS=2

# --- Tracing (optional; install with `uv sync --extra tracing`) ---
# Langfuse keys from a free Langfuse Cloud project; tracing is off when empty
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Send prompt and answer text too (they contain example values); off by default
LANGFUSE_CAPTURE_PROMPTS=false

# --- KPIs (KPI__<NAME>) ---
# As-of date for receivables aging (empty = today); the sample data is as of 2026-06-30
KPI__REFERENCE_DATE=2026-06-30
# Upper bounds of the aging buckets in days past due (JSON); the last bucket is open-ended
KPI__AGING_BUCKET_EDGES=[30,60,90]
# Rows in the "top customers" style dashboard metrics
KPI__TOP_N=10
# Most rows kept per dashboard metric
KPI__MAX_METRIC_ROWS=200

# --- Rate and size limits (LIMITS__<NAME>) ---
# Requests per minute from one client (IP address), for every endpoint but /health
LIMITS__REQUESTS_PER_MINUTE=240
# Runs started plus questions asked per client (these use the language model)
LIMITS__EXPENSIVE_PER_MINUTE=6
LIMITS__EXPENSIVE_PER_DAY=60
# The same across all clients, to protect the free model quota
LIMITS__EXPENSIVE_GLOBAL_PER_DAY=300
# Largest JSON request body in KB (uploads use MAX_UPLOAD_MB)
LIMITS__MAX_BODY_KB=512
# Trusted proxies in front of the API (1 on Render): the client address is the
# X-Forwarded-For entry they added, counted from the right. 0 uses the connecting address
LIMITS__FORWARDED_HOPS=0

# --- Questions in plain English (QA__<NAME>) ---
# Longest question accepted, in characters
QA__MAX_QUESTION_CHARS=500
# Example values per column shown to the model
QA__EXAMPLE_VALUES=3
# Model attempts per question (the first draft plus fixes after a guard refusal)
QA__MAX_ATTEMPTS=2
# Most rows an answer returns
QA__ROW_LIMIT=1000
# Seconds a question's query may run before it is cancelled
QA__TIMEOUT_SECONDS=10
# Longest text kept in one answer cell (longer text is cut with an ellipsis)
QA__MAX_CELL_CHARS=1000
# Largest answer in bytes of JSON; rows past it are left out and the answer is marked cut
QA__MAX_RESULT_BYTES=2000000
# Longest example value shown to the model, in characters
QA__EXAMPLE_MAX_CHARS=40

# --- Checks on generated views (CHECKS__<NAME>) ---
# Highest share of join keys with no match, or empty, before a check fails
CHECKS__MAX_ORPHAN_RATE=0.05
CHECKS__MAX_NULL_RATE=0.05
# Relative difference allowed between money totals in a view and its fact table
CHECKS__RECONCILIATION_TOLERANCE=1e-9
